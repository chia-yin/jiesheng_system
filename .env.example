# 杰升考勤系統 — 環境變數範例
# 複製為 .env.local 後填入實際值

# ---------------------------------------------------------------------------
# 階段 1：Supabase（新建獨立 Project，勿與其他專案共用）
# 設定後系統改走 Postgres，未設定則使用本地 data/system.json
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 階段 3：啟用 Supabase Auth 登入（需先執行 npm run sync:supabase-auth）
USE_SUPABASE_AUTH=false
SUPABASE_AUTH_EMAIL_DOMAIN=users.jiesheng.internal

# Session 簽章（正式環境請改為隨機長字串）
SESSION_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# 階段 2：LINE Bot（Webhook 需 HTTPS，部署 Netlify 後設定）
# ---------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE 圖文選單 ID（也可在後台「整合設定」填寫，員工綁定後自動掛載）
LINE_RICH_MENU_ID=

# 排程打卡提醒（Netlify Scheduled Functions 用，請設隨機長字串）
CRON_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar OAuth（選用）
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/login/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 正式環境範例：
# GOOGLE_REDIRECT_URI=https://jiesheng-system.netlify.app/api/auth/google/callback
# GOOGLE_LOGIN_REDIRECT_URI=https://jiesheng-system.netlify.app/api/auth/google/login/callback
# NEXT_PUBLIC_APP_URL=https://jiesheng-system.netlify.app
